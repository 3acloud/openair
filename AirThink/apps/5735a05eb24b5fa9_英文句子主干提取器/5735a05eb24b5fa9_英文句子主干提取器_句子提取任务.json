{
  "表名": "句子提取任务",
  "字段": [
    {
      "字段名": "任务标题",
      "类型": "文本"
    },
    {
      "字段名": "英文句子",
      "类型": "文本"
    },
    {
      "字段名": "句子来源",
      "类型": "文本"
    },
    {
      "字段名": "提取目标",
      "类型": "多选项",
      "可选项": [
        "主谓宾",
        "主系表",
        "主谓"
      ]
    },
    {
      "字段名": "难度等级",
      "类型": "单选项",
      "可选项": [
        "基础",
        "中等",
        "复杂"
      ]
    },
    {
      "字段名": "主干提取结果",
      "类型": "指令流",
      "指令类型": "生成文本",
      "指令描述": "我是一名英语语法分析助手，请从下面的英文句子中提取句子主干。主干包括主谓宾、主系表或主谓结构。请判断句型，标出主语、谓语、宾语或表语，并给出简洁说明。\n---\n英文句子：{{英文句子}}\n提取目标：{{提取目标}}\n难度等级：{{难度等级}}"
    },
    {
      "字段名": "创建时间",
      "类型": "日期时间"
    },
    {
      "字段名": "是否已复核",
      "类型": "布尔"
    },
    {
      "字段名": "复核备注",
      "类型": "文本"
    }
  ]
}