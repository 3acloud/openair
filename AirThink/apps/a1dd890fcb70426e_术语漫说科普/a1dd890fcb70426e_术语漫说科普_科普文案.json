{
  "表名": "科普文案",
  "字段": [
    {
      "字段名": "文案标题",
      "类型": "文本"
    },
    {
      "字段名": "术语名称",
      "类型": "关联表",
      "关联表名": "专业术语",
      "关联字段名": "术语名称"
    },
    {
      "字段名": "目标受众",
      "类型": "单选项",
      "可选项": [
        "儿童",
        "青少年",
        "大众",
        "大学生"
      ]
    },
    {
      "字段名": "风格偏好",
      "类型": "单选项",
      "可选项": [
        "幽默风趣",
        "故事叙述",
        "生活类比",
        "简洁明了"
      ]
    },
    {
      "字段名": "创建时间",
      "类型": "日期时间"
    },
    {
      "字段名": "生动解说",
      "类型": "指令流",
      "指令类型": "生成文本",
      "指令描述": "我是一名擅长把复杂知识讲明白的科普创作者。请将下列专业术语转化为生动有趣、通俗易懂的解说文案，面向{{目标受众}}，采用{{风格偏好}}的表达方式，多用生活化比喻和场景故事，篇幅控制在300字左右，适合后续制成漫画分镜和有声播报。\n---\n术语名称：{{术语名称}}\n所属领域：{{专业术语.所属领域}}\n原始释义：{{专业术语.原始释义}}\n难度等级：{{专业术语.难度等级}}\n关键词：{{专业术语.关键词}}"
    }
  ]
}