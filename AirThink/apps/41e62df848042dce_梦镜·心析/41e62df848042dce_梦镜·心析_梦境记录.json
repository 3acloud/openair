{
  "表名": "梦境记录",
  "字段": [
    {
      "字段名": "记录ID",
      "类型": "数值"
    },
    {
      "字段名": "梦境日期",
      "类型": "日期"
    },
    {
      "字段名": "梦境标题",
      "类型": "文本"
    },
    {
      "字段名": "梦境内容",
      "类型": "文本"
    },
    {
      "字段名": "梦境类型",
      "类型": "多选项",
      "可选项": [
        "飞行",
        "坠落",
        "被追",
        "考试",
        "奇幻",
        "其他"
      ]
    },
    {
      "字段名": "情绪状态",
      "类型": "多选项",
      "可选项": [
        "开心",
        "恐惧",
        "焦虑",
        "平静",
        "悲伤",
        "愤怒",
        "惊喜"
      ]
    },
    {
      "字段名": "图片",
      "类型": "图片"
    },
    {
      "字段名": "音频",
      "类型": "文件"
    },
    {
      "字段名": "AI解析",
      "类型": "指令流",
      "指令类型": "生成文本",
      "指令描述": "请根据以下梦境内容，为心理学爱好者提供专业的梦境解析，包括可能象征意义、情感联系以及自我成长建议。梦境内容：{{梦境内容}}"
    },
    {
      "字段名": "创建时间",
      "类型": "日期时间"
    },
    {
      "字段名": "修改时间",
      "类型": "日期时间"
    }
  ]
}