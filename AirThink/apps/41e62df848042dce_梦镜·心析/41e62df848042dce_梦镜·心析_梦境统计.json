{
  "表名": "梦境统计",
  "字段": [
    {
      "字段名": "统计ID",
      "类型": "数值"
    },
    {
      "字段名": "统计名称",
      "类型": "文本"
    },
    {
      "字段名": "开始日期",
      "类型": "日期"
    },
    {
      "字段名": "结束日期",
      "类型": "日期"
    },
    {
      "字段名": "统计类型",
      "类型": "单选项",
      "可选项": [
        "情绪统计分析",
        "梦境类型统计分析",
        "关键词词云",
        "梦境长度趋势"
      ]
    },
    {
      "字段名": "统计结果图片",
      "类型": "指令流",
      "指令类型": "输出文档",
      "文档类型": ".png",
      "指令描述": "根据统计类型字段的值，执行相应的统计分析：如果统计类型为情绪统计分析，则生成情绪分布饼图；如果为梦境类型统计分析，则生成梦境类型柱状图；如果为关键词词云，则生成词云图片；如果为梦境长度趋势，则生成折线图。时间范围为{{开始日期}}至{{结束日期}}。"
    }
  ]
}