{
  "表名": "搜题记录",
  "字段": [
    {
      "字段名": "题目图片",
      "类型": "指令流",
      "指令类型": "生成格式化文本",
      "指令描述": "请仔细识别并提取这张图片中的题目文字，然后给出详尽的解题步骤和最终答案，并判断题目的所属科目。以JSON格式输出\"题目内容\"、\"解题过程\"、\"科目\"。"
    },
    {
      "字段名": "题目内容",
      "类型": "文本"
    },
    {
      "字段名": "解题过程",
      "类型": "文本"
    },
    {
      "字段名": "科目",
      "类型": "单选项",
      "可选项": [
        "数学",
        "语文",
        "英语",
        "物理",
        "化学",
        "生物",
        "政治",
        "历史",
        "地理",
        "其他"
      ]
    },
    {
      "字段名": "加入错题本",
      "类型": "布尔"
    },
    {
      "字段名": "提交时间",
      "类型": "日期时间"
    }
  ]
}