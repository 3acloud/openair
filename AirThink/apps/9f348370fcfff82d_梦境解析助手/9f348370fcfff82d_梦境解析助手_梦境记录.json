{
  "表名": "梦境记录",
  "字段": [
    {
      "字段名": "记录ID",
      "类型": "文本"
    },
    {
      "字段名": "梦境内容",
      "类型": "文本"
    },
    {
      "字段名": "记录日期",
      "类型": "日期时间"
    },
    {
      "字段名": "梦境类型",
      "类型": "单选项",
      "可选项": [
        "噩梦",
        "美梦",
        "中性",
        "其他"
      ]
    },
    {
      "字段名": "情绪",
      "类型": "多选项",
      "可选项": [
        "快乐",
        "悲伤",
        "恐惧",
        "愤怒",
        "平静",
        "其他"
      ]
    },
    {
      "字段名": "解析结果",
      "类型": "指令流",
      "指令类型": "生成文本",
      "指令描述": "你是一名专业的梦境解析专家，精通心理学和弗洛伊德、荣格等梦境理论。请根据以下梦境内容，提供详细的解析报告，包括象征意义、潜在心理含义、情绪关联分析以及自我成长建议。以Markdown格式结构化输出：\n\n## 梦境概述\n[简述梦境]\n\n## 象征解释\n[详细解析关键元素]\n\n## 心理洞察\n[分析潜意识含义]\n\n## 情绪关联\n[链接用户情绪]\n\n## 成长建议\n[实用建议]\n\n梦境内容：{{梦境内容}}\n\n梦境类型：{{梦境类型}}\n\n情绪：{{情绪}}"
    }
  ]
}