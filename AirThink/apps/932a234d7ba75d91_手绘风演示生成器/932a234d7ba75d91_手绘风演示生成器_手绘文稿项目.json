{
  "表名": "手绘文稿项目",
  "字段": [
    {
      "字段名": "项目名称",
      "类型": "文本"
    },
    {
      "字段名": "内容来源",
      "类型": "关联表",
      "关联表名": "文档源解析",
      "关联字段名": "任务编号"
    },
    {
      "字段名": "纸张质感材质",
      "类型": "单选项",
      "可选项": [
        "牛皮纸",
        "素描纸",
        "水彩纸",
        "网格手账本",
        "黑板"
      ]
    },
    {
      "字段名": "手绘排版风格",
      "类型": "单选项",
      "可选项": [
        "极简手写线条",
        "素描草图风格",
        "彩色马克笔",
        "手账拼贴图文"
      ]
    },
    {
      "字段名": "生成的演示文稿文件",
      "类型": "指令流",
      "指令类型": "输出文档",
      "文档类型": ".html",
      "指令描述": "请结合演示文稿大纲内容：{{文档源解析.提取文稿大纲}}，生成一个带有真实质感的手绘风格在线HTML演示文稿。要求：整个演示文稿需为基于HTML、CSS和JavaScript的单文件。背景请采用逼真的{{纸张质感材质}}CSS纹理，文字、边框和装饰元素需体现{{手绘排版风格}}，请使用手写感字体和不规则元素边框，排版保持简洁优雅。页面需内嵌简单的左右滑动翻页交互脚本，以支持在线演示。输出此HTML文件内容。"
    },
    {
      "字段名": "创建日期",
      "类型": "日期"
    }
  ]
}