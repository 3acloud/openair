{
  "表名": "测试答卷与报告",
  "字段": [
    {
      "字段名": "测试人昵称",
      "类型": "文本"
    },
    {
      "字段名": "测试时间",
      "类型": "日期时间"
    },
    {
      "字段名": "情景一加班态度",
      "类型": "单选项",
      "可选项": [
        "欣然接受",
        "无奈留下",
        "准点跑路",
        "发疯掀桌"
      ]
    },
    {
      "字段名": "情景二面对内卷",
      "类型": "单选项",
      "可选项": [
        "比他更卷",
        "关我屁事",
        "表面配合",
        "阴阳怪气"
      ]
    },
    {
      "字段名": "情景三老板画饼",
      "类型": "单选项",
      "可选项": [
        "深信不疑",
        "左耳进右耳出",
        "反向画饼",
        "只认搞钱"
      ]
    },
    {
      "字段名": "情景四天降大锅",
      "类型": "单选项",
      "可选项": [
        "委屈接盘",
        "当面硬刚",
        "巧妙躲避",
        "甩给别人"
      ]
    },
    {
      "字段名": "工作状态补充描述",
      "类型": "文本"
    },
    {
      "字段名": "NMTI评测分析报告",
      "类型": "指令流",
      "指令类型": "生成文本",
      "指令描述": "我是一名职场心理分析师，请根据测试者的选择判定他的NMTI（牛马职场人格）类型，并出具一份幽默搞怪的测试报告，包含：人格名称、性格解析、职场战斗力、生存建议。测试人：{{测试人昵称}}，加班态度：{{情景一加班态度}}，面对内卷：{{情景二面对内卷}}，老板画饼：{{情景三老板画饼}}，面对甩锅：{{情景四天降大锅}}，日常状态：{{工作状态补充描述}}。"
    }
  ]
}