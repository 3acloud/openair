        "会议",
        "生活记录",
        "其他"
      ]
    },
    {
      "字段名": "标签",
      "类型": "多选项",
      "可选项": [
        "工作",
        "学习",
        "生活",
        "灵感闪现",
        "重要",
        "紧急",
        "会议纪要",
        "随手记"
      ]
    },
    {
      "字段名": "是否重点",
      "类型": "布尔"
    },
    {
      "字段名": "记录时间",
      "类型": "日期时间"
    },
    {
      "字段名": "归档状态",
      "类型": "单选项",
      "可选项": [
        "待整理",
        "已归档",
        "已完成"
      ]
