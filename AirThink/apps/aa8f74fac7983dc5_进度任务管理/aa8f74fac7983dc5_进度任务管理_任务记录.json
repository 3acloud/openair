{
  "表名": "任务记录",
  "字段": [
    {
      "字段名": "任务内容",
      "类型": "文本"
    },
    {
      "字段名": "优先级",
      "类型": "单选项",
      "可选项": [
        "高",
        "中",
        "低"
      ]
    },
    {
      "字段名": "状态",
      "类型": "单选项",
      "可选项": [
        "待办",
        "进行中",
        "阻塞",
        "已完成",
        "已取消"
      ]
    },
    {
      "字段名": "开始时间",
      "类型": "日期时间"
    },
    {
      "字段名": "完成时间",
      "类型": "日期时间"
    },
    {
      "字段名": "进度",
      "类型": "数值"
    },
    {
      "字段名": "备注",
      "类型": "文本"
    },
    {
      "字段名": "阻塞原因",
      "类型": "文本"
    },
    {
      "字段名": "等待中",
      "类型": "文本"
    },
    {
      "字段名": "任务处理",
      "类型": "指令流",
      "指令类型": "任务智能体",
      "指令描述": "请使用技能445b2fca65c887d2_task-manager处理进度任务管理：根据任务内容、优先级、状态、开始时间、完成时间、进度、备注、阻塞原因和等待中信息，维护任务看板、更新任务生命周期，并在需要时输出任务进度汇报。\n---\n任务内容：{{任务内容}}\n优先级：{{优先级}}\n状态：{{状态}}\n开始时间：{{开始时间}}\n完成时间：{{完成时间}}\n进度：{{进度}}\n备注：{{备注}}\n阻塞原因：{{阻塞原因}}\n等待中：{{等待中}}",
      "文件字段": "",
      "输出类型": "文本"
    }
  ]
}