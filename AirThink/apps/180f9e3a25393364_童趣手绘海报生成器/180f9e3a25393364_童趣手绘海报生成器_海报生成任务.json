      "关联字段名": "主题名称"
    },
    {
      "字段名": "关键词",
      "类型": "文本"
    },
    {
      "字段名": "生成方式",
      "类型": "单选项",
      "可选项": [
        "随机生成",
        "关键词生成"
      ]
    },
    {
      "字段名": "绘画难度",
      "类型": "单选项",
      "可选项": [
        "低年级简单",
        "中年级适中",
        "高年级丰富"
      ]
    },
    {
      "字段名": "海报尺寸",
      "类型": "单选项",
      "可选项": [
        "A4竖版",
        "A4横版",
        "手抄报横版",
        "方形海报"
      ]
    },
    {
      "字段名": "手绘风格",
      "类型": "单选项",
      "可选项": [
        "彩铅儿童画",
        "马克笔手抄报",
        "蜡笔涂鸦",
        "水彩插画",
        "黑白线稿"
      ]
    },
    {
      "字段名": "配色偏好",
      "类型": "单选项",
      "可选项": [
        "明亮活泼",
        "清新柔和",
        "红黄醒目",
        "蓝绿清爽",
        "随机配色"
      ]
